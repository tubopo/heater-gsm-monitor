# EditorConfig is awesome: https://EditorConfig.org
# Top-most EditorConfig file
root = true

# ============================================
# Default Settings for All Files
# ============================================
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# ============================================
# Arduino Source Code (.ino, .h, .cpp, .c)
# ============================================
[*.{ino,h,hpp,cpp,c}]
indent_style = space
indent_size = 2
max_line_length = 100

# ============================================
# C/C++ Headers
# ============================================
[*.h]
indent_style = space
indent_size = 2

# ============================================
# Makefile (must use tabs)
# ============================================
[Makefile]
indent_style = tab
indent_size = 4

# ============================================
# JSON Configuration
# ============================================
[*.json]
indent_style = space
indent_size = 2

# ============================================
# Markdown Documentation
# ============================================
[*.md]
trim_trailing_whitespace = false
max_line_length = off
